{
  "properties": {
    "targetHost": "localhost",
    "targetPort": 8080,
    "registryAddress": "zookeeper://localhost:2181"
  },
  "trigger": {
    "type": "dubbo-provider",
    "config": {
      "registryAddress": "{{registryAddress}}",
      "serviceId": "io.terminus.dalaran.example.OrderService",
      "method": "getUserOrders",
      "version": "terminus",
      "parameterTypes": [
        "java.lang.String"
      ]
    }
  },
  "processors": [
    {
      "type": "http-client",
      "config": {
        "protocol": "HTTP",
        "method": "POST",
        "host": "{{targetHost}}",
        "port": "{{targetPort}}",
        "path": "/orders_dubbo"
      }
    },
    {
      "type": "router",
      "config": {
        "routes": [
          {
            "when": "abc",
            "processor": {
              "type":"route-type",
              "configInstanceId": "aaabbbccc",
              "config":{
                "a":"a1"
              }
            }
          }
        ],
        "mappings": {
          "target":"t",
          "source":"s"
        }
      }
    }
  ]
}