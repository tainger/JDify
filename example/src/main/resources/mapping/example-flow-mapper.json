{
  "properties": {
    "port": 8184,
    "targetHost": "localhost",
    "targetPort": 8080
  },
  "trigger": {
    "type": "netty-http-listener",
    "config": {
      "protocol": "HTTP",
      "host": "0.0.0.0",
      "port": 8184,
      "path": "/orderItemsMapper",
      "method": "POST"
    }
  },
  "processors": [
    {
      "type": "custom-convert",
      "config": {
        "messageMapping": {
          "id": "mappings/mapping/field/id",
          "itemName": "mappings/mapping/field/name",
          "itemPrice": "mappings/mapping/field/price"
        },
        "target": ["id", "name", "price"],
        "targetType": "XML",
        "destination": ["id", "itemName", "itemPrice"],
        "destinationType": "JSON"
      }
    },
    {
      "type": "http-client",
      "config": {
        "protocol": "HTTP",
        "method": "POST",
        "host": "{{targetHost}}",
        "port": "{{targetPort}}",
        "path": "/orders"
      }
    }
  ]
}