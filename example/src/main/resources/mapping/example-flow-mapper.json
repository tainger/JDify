{
  "properties": {
    "port": 8184,
    "targetHost": "localhost",
    "targetPort": 8080
  },
  "trigger": {
    "type": "netty-http-listener",
    "config": {
      "protocol": "HTTP",
      "host": "0.0.0.0",
      "port": 8184,
      "path": "/orderItemsMapper",
      "method": "POST"
    }
  },
  "processors": [
    {
      "type": "custom-convert",
      "config": {
        "messageMapping": {
          "target": {
            "fields": [
              {"id": ""},
              {"name": ""},
              {"price": ""}
            ],
            "type": "json"
          },
          "destination": {
            "fields": [
              {"id": ""},
              {"itemName": ""},
              {"itemPrice": ""}
            ],
            "type": "json"
          },
          "singleFieldMappings": [
            {
              "mapping": {
                "id": "id"
              },
              "function": {
                "fieldsIn": [],
                "fieldsOut": [],
                "execution": ""
              }
            },
            {
              "mapping": {
                "itemName": "name"
              },
              "function": {
                "fieldsIn": [],
                "fieldsOut": [],
                "execution": ""
              }
            },
            {
              "mapping": {
                "itemPrice": "price"
              },
              "function": {
                "fieldsIn": [],
                "fieldsOut": [],
                "execution": ""
              }
            }
          ]
        }
      }
    },
    {
      "type": "http-client",
      "config": {
        "protocol": "HTTP",
        "method": "POST",
        "host": "{{targetHost}}",
        "port": "{{targetPort}}",
        "path": "/orders"
      }
    }
  ]
}