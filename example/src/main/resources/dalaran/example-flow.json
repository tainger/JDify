{
  "properties": {
    "port": 8184,
    "targetHost": "localhost",
    "targetPort": 8080
  },
  "trigger": {
    "type": "netty-http-listener",
    "config": {
      "protocol": "HTTP",
      "host": "0.0.0.0",
      "port": "{{port}}",
      "path": "/orderItems",
      "method": "POST"
    }
  },
  "processors": [
    {
      "type": "http-client",
      "config": {
        "protocol": "HTTP",
        "method": "POST",
        "host": "{{targetHost}}",
        "port": "{{targetPort}}",
        "path": "/orders"
      }
    }
  ]
}