<idea-plugin>
    <id>io.terminus.dalaran</id>
    <name>集成平台插件(Dalaran)</name>
    <version>0.0.1</version>
    <vendor email="gr.gengrong@alibaba-inc.com" url="http://dalaran.terminus.io">Terminus</vendor>

    <description><![CDATA[
      配合端点集成平台使用, 主要有以下功能:
      1. 快速生成 Json
      2. 快速生成 ModelSchema
      3. 快速创建 Trigger
      4. 快速创建 Processor
    ]]></description>

    <change-notes><![CDATA[
      0.0.1: first release.
    ]]>
    </change-notes>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html for description -->
    <idea-version since-build="171.0"/>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <!-- uncomment to enable plugin in all products
    <depends>com.intellij.modules.lang</depends>
    -->

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
    </extensions>

    <actions>
        <!-- Add your actions here -->
        <action id="Dalaran.ConvertJson" class="io.terminus.dalaran.action.ConvertToJson" text="Convert JSON"
                description="Convert java class to JSON">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta alt J"/>
        </action>
        <action id="Dalaran.ConvertDalaranSchema" class="io.terminus.dalaran.action.ConvertToSchema"
                text="Convert Model Schema"
                description="Convert java class to dalaran model schema">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Dalaran.ConvertDubboTrigger" class="io.terminus.dalaran.action.ConvertDubboTrigger"
                text="Convert Dubbo Trigger"
                description="Convert dalaran dubbo trigger">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Dalaran.ConvertRestTriggerDubboFlow" class="io.terminus.dalaran.action.ConvertRestTriggerDubboFlow"
                text="Convert Rest Trigger Call This Dubbo API"
                description="Convert rest trigger call this dubbo API">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Dalaran.ConvertDubboProcessor" class="io.terminus.dalaran.action.ConvertDubboProcessor"
                text="Convert Dubbo Processor"
                description="Convert dalaran dubbo processor">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>